---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'mmyy1217 — AI Compilers',
  description = 'Public index for AI compiler engineering, instruction references, and open kernel tooling.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f5" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
